# Settings for your computer. This file is NOT uploaded to GitHub (.gitignore).
PORT=3000

# XAMPP's MySQL: user "root" with an empty password by default
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=autocare

# Secret used to sign login tokens (change to any long random text)
JWT_SECRET=change-this-to-a-long-random-secret
