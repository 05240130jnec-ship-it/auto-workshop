# Copy this file to .env and fill it in. Never upload .env to GitHub.

# ----- Server -----
PORT=3000

# ----- MySQL (XAMPP) -----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=autoconnection

# ----- Login tokens -----
JWT_SECRET=put_any_long_random_text_here

# ----- Starting passwords (used only by: node seed.js) -----
# seed.js creates the first admin, mechanic and customer with these passwords.
# MySQL stores only the bcrypt hash. Change them later on the website.
ADMIN_PASSWORD=admin123
MECHANIC_PASSWORD=mech123
CUSTOMER_PASSWORD=user123
